{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-link.local/schema/protocol-spec-1.0.json",
  "title": "Device protocol parser specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "protocolId", "protocolVersion", "models", "inputEncoding", "maxPayloadBytes", "documents", "messages", "mappings"],
  "properties": {
    "specVersion": {"const": "1.0"},
    "protocolId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "protocolVersion": {"type": "string", "minLength": 1},
    "models": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "inputEncoding": {"enum": ["bytes", "hex", "utf8-json", "modbus-registers", "mixed"]},
    "maxPayloadBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
    "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "file", "sourceType"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "file": {"type": "string", "minLength": 1},
        "sourceType": {"enum": ["document", "vendor-clarification", "field-confirmation", "fictional"]},
        "version": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["documentId", "location"],
      "properties": {
        "documentId": {"type": "string"}, "location": {"type": "string", "minLength": 1},
        "quote": {"type": "string"}, "sourceType": {"type": "string"}
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "offset": {"type": "integer", "minimum": 0}, "length": {"type": "integer", "minimum": 1},
        "bitOffset": {"type": "integer", "minimum": 0, "maximum": 63}, "bitLength": {"type": "integer", "minimum": 1, "maximum": 64},
        "path": {"type": "string"}, "collectionPath": {"type": "string"}, "matchKey": {"type": "string"},
        "matchValue": {}, "valueKey": {"type": "string"},
        "address": {"type": "integer", "minimum": 0}, "displayAddress": {"type": ["integer", "string"]},
        "registerCount": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "source", "selector", "type", "scale", "offset", "unit", "unitStatus", "required", "confirmed"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "source": {"$ref": "#/$defs/source"}, "selector": {"$ref": "#/$defs/selector"},
        "type": {"enum": ["uint8", "int8", "uint16", "int16", "uint32", "int32", "float32", "boolean", "string", "number", "integer", "bits"]},
        "bitWidth": {"type": "integer", "enum": [1,2,3,4,5,6,7,8,16,32]},
        "signed": {"type": "boolean"}, "byteOrder": {"enum": ["big", "little", "none"]},
        "wordOrder": {"enum": ["high-first", "low-first", "none", "unknown"]},
        "scale": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
        "offset": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
        "unit": {"type": ["string", "null"]}, "unitStatus": {"enum": ["known", "unknown", "dimensionless"]},
        "range": {"type": "object", "properties": {"min": {"type": "number"}, "max": {"type": "number"}}, "additionalProperties": false},
        "enum": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "sentinels": {"type": "array", "items": {}}, "required": {"type": "boolean"}, "confirmed": {"type": "boolean"},
        "sharedBits": {"type": "boolean"}, "missing": {"enum": ["error", "warning", "omit", "null"]},
        "registerType": {"enum": ["holding", "input", "coil", "discrete"]}
      }
    },
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "inputType", "fields"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "inputType": {"enum": ["binary", "json", "modbus"]},
        "match": {"type": "object", "properties": {"offset": {"type": "integer", "minimum": 0}, "bytes": {"type": "string", "pattern": "^(?:[0-9A-Fa-f]{2})+$"}, "path": {"type": "string"}, "equals": {}, "registerType": {"type": "string"}}, "additionalProperties": false},
        "length": {"type": "object", "properties": {"exact": {"type": "integer", "minimum": 0}, "min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        "requiredContext": {"type": "array", "items": {"type": "string"}},
        "checksum": {"type": "object", "required": ["algorithm", "start", "endExclusive", "position", "initial"], "properties": {"algorithm": {"type": "string"}, "start": {"type": "integer", "minimum": 0}, "endExclusive": {"type": "integer", "minimum": 1}, "position": {"type": "integer", "minimum": 0}, "initial": {"type": "integer", "minimum": 0, "maximum": 255}, "required": {"type": "boolean"}}, "additionalProperties": false},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "targetPath", "targetType", "required", "contractVersion"],
      "properties": {"source": {"type": "string"}, "targetPath": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"}, "targetType": {"enum": ["string", "number", "integer", "boolean", "object", "array"]}, "conversion": {"type": ["string", "null"]}, "contextSource": {"type": ["string", "null"]}, "required": {"type": "boolean"}, "missing": {"enum": ["error", "omit", "null"]}, "contractVersion": {"type": "string"}}
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scope", "interpretations", "affected"],
      "properties": {"id": {"type": "string"}, "scope": {"enum": ["field", "message", "protocol"]}, "interpretations": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["value", "source"], "properties": {"value": {}, "source": {"$ref": "#/$defs/source"}}, "additionalProperties": false}, "affected": {"type": "array", "items": {"type": "string"}}, "resolution": {"type": ["string", "null"]}}
    }
  }
}
}
